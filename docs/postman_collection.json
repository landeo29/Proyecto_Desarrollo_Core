{
  "info": {
    "name": "Sistema Compras y Ventas - Microservicios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gateway}}/productos/api/Auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Productos - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/productos/api/Producto"
      }
    },
    {
      "name": "Productos - Registrar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{gateway}}/productos/api/Producto",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreProducto\": \"Mouse Logitech\",\n  \"nroLote\": \"LOTE-010\",\n  \"costo\": 50,\n  \"precioVenta\": 67.5\n}"
        }
      }
    },
    {
      "name": "Compras - Registrar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{gateway}}/compras/api/Compra",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"detalles\": [\n    { \"idProducto\": 1, \"cantidad\": 10, \"precio\": 100 }\n  ]\n}"
        }
      }
    },
    {
      "name": "Compras - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/compras/api/Compra"
      }
    },
    {
      "name": "Ventas - Registrar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{gateway}}/ventas/api/Venta",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"detalles\": [\n    { \"idProducto\": 1, \"cantidad\": 2, \"precio\": 135 }\n  ]\n}"
        }
      }
    },
    {
      "name": "Ventas - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/ventas/api/Venta"
      }
    },
    {
      "name": "Movimientos - Stock de producto",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/movimientos/api/Movimiento/stock/1"
      }
    },
    {
      "name": "Movimientos - Por producto",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/movimientos/api/Movimiento/producto/1"
      }
    }
  ]
}